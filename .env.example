# LingoBloom - cấu hình local
# Sao chép tệp này thành .env ở thư mục gốc trước khi chạy.

# Express API
PORT=3001
CLIENT_URL=http://localhost:5173

# Vite đọc hai biến này từ chính .env ở thư mục gốc.
VITE_DEV_API_TARGET=http://localhost:3001
VITE_API_URL=/api

# Hãy thay bằng một chuỗi dài, ngẫu nhiên trước khi dùng ngoài máy cá nhân.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Demo vẫn dùng được khi Google OAuth chưa cấu hình.
DEMO_AUTH_ENABLED=true

# Google OAuth 2.0 - để trống nếu chỉ dùng demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# MongoDB Atlas (bắt buộc). Dán connection string do Atlas cung cấp và thay
# <username>, <password>, <cluster-host>. Không commit tệp .env lên Git.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=lingobloom
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10

# Collection lưu phiên đăng nhập (mặc định: sessions).
SESSION_COLLECTION=sessions

# Provider từ điển mặc định không cần API key.
DICTIONARY_PROVIDER=free_dictionary
DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries

# Express phục vụ client/dist sau khi chạy npm run build.
SERVE_CLIENT=true

# Local development
NODE_ENV=development
SECURE_COOKIES=false
APP_TIME_ZONE_OFFSET_MINUTES=420

# Production qua HTTPS nên dùng:
# NODE_ENV=production
# SECURE_COOKIES=true
