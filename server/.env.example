PORT=3001
CLIENT_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# The UI stays usable through demo login when these are blank.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
DEMO_AUTH_ENABLED=true

# Required outside automated tests. Paste the connection string from Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=lingobloom
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
# Application sessions are stored in the same MongoDB database.
SESSION_COLLECTION=sessions

# DictionaryAPI.dev is used through a provider abstraction by default.
DICTIONARY_PROVIDER=free_dictionary
DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries

# Enable after building client/dist when starting the server directly.
SERVE_CLIENT=true
NODE_ENV=development
SECURE_COOKIES=false
APP_TIME_ZONE_OFFSET_MINUTES=420
