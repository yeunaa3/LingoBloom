PORT=3001
# Render derives this from RENDER_EXTERNAL_HOSTNAME unless a custom domain overrides it.
CLIENT_URL=http://localhost:5173
# Also signs short-lived dictionary selections; never expose the real value.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# The UI stays usable through demo login when these are blank.
# Render derives its callback from RENDER_EXTERNAL_HOSTNAME automatically;
# override this only for local development or a custom domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
DEMO_AUTH_ENABLED=true

# Required outside automated tests. Paste the connection string from Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=lingobloom
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
# Application sessions are stored in the same MongoDB database.
SESSION_COLLECTION=sessions

# DictionaryAPI.dev is used through a provider abstraction by default.
DICTIONARY_PROVIDER=free_dictionary
DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries
# Datamuse currently needs no key through 2026; see README for the 2027 change.
DICTIONARY_SUGGEST_API_BASE_URL=https://api.datamuse.com/sug
# German suggestions and exact word verification use the public MediaWiki API; no key required.
DICTIONARY_GERMAN_WIKTIONARY_API_BASE_URL=https://de.wiktionary.org/w/api.php
DICTIONARY_TRANSLATION_API_BASE_URL=https://api.mymemory.translated.net/get
DICTIONARY_SELECTION_TTL_SECONDS=300

# Enable after building client/dist when starting the server directly.
SERVE_CLIENT=true
NODE_ENV=development
SECURE_COOKIES=false
APP_TIME_ZONE_OFFSET_MINUTES=420
